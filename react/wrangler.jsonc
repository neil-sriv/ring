{
  // Workers Builds reads this file — there is no "Build output directory"
  // field in the current dashboard create flow.
  // Docs: https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/
  "name": "ring-frontend",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": true,
  // Runs ahead of the assets on page routes so link-preview crawlers get Open
  // Graph HTML instead of the SPA shell. Browsers fall through to the assets.
  // See src/worker.ts.
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Hashed bundles are the bulk of the bytes and are never previewed, so
    // they stay on the asset-first path.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Mirrors the observability settings enabled in the Cloudflare dashboard so
  // deploys from this config don't reset them. Page routes now invoke `main`;
  // leave these flags alone so a deploy does not turn dashboard logs off.
  // Docs: https://developers.cloudflare.com/workers/observability/
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
