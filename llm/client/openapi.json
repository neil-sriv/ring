{
    "openapi": "3.1.0",
    "info": {
        "title": "FastAPI",
        "version": "0.1.0"
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "paths": {
        "/auth/status": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "Auth Status",
                "description": "Check authentication status",
                "operationId": "auth_status_auth_status_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                },
                "security": [
                    {
                        "APIKeyHeader": []
                    }
                ]
            }
        },
        "/completions/generate": {
            "post": {
                "tags": [
                    "completions"
                ],
                "summary": "Generate Completion",
                "description": "Stub endpoint for text completion generation",
                "operationId": "generate_completion_completions_generate_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CompletionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompletionResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "APIKeyHeader": []
                    }
                ]
            }
        },
        "/completions/test": {
            "post": {
                "tags": [
                    "completions"
                ],
                "summary": "Test Completion",
                "description": "Test endpoint that returns a simple Hello World completion",
                "operationId": "test_completion_completions_test_post",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompletionResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "APIKeyHeader": []
                    }
                ]
            }
        },
        "/rag/query": {
            "post": {
                "tags": [
                    "rag"
                ],
                "summary": "Query Rag",
                "description": "Stub endpoint for RAG query",
                "operationId": "query_rag_rag_query_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RAGRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RAGResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "APIKeyHeader": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "CompletionRequest": {
                "properties": {
                    "prompt": {
                        "type": "string",
                        "title": "Prompt"
                    },
                    "max_tokens": {
                        "type": "integer",
                        "title": "Max Tokens",
                        "default": 100
                    },
                    "output_schema_definition": {
                        "type": "string",
                        "title": "Output Schema Definition"
                    }
                },
                "type": "object",
                "required": [
                    "prompt",
                    "output_schema_definition"
                ],
                "title": "CompletionRequest"
            },
            "CompletionResponse": {
                "properties": {
                    "text": {
                        "type": "string",
                        "title": "Text"
                    },
                    "output_schema": {
                        "type": "string",
                        "title": "Output Schema"
                    }
                },
                "type": "object",
                "required": [
                    "text",
                    "output_schema"
                ],
                "title": "CompletionResponse"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "RAGRequest": {
                "properties": {
                    "query": {
                        "type": "string",
                        "title": "Query"
                    },
                    "context_window": {
                        "type": "integer",
                        "title": "Context Window",
                        "default": 2000
                    }
                },
                "type": "object",
                "required": [
                    "query"
                ],
                "title": "RAGRequest"
            },
            "RAGResponse": {
                "properties": {
                    "answer": {
                        "type": "string",
                        "title": "Answer"
                    },
                    "sources": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Sources"
                    },
                    "usage": {
                        "type": "object",
                        "title": "Usage"
                    }
                },
                "type": "object",
                "required": [
                    "answer",
                    "sources",
                    "usage"
                ],
                "title": "RAGResponse"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        },
        "securitySchemes": {
            "APIKeyHeader": {
                "type": "apiKey",
                "in": "header",
                "name": "X-API-Key"
            }
        }
    }
}