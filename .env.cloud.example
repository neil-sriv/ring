# Cloud Agent VM defaults — copied to .env by .cursor/cloud-start.sh when missing.
# For Vite dev, leave VITE_API_URL empty: the dev server proxies /api/v1 to :8001.
# Do not set VITE_API_URL=https://localhost here — Cursor secrets / shell env that
# inject it break HTTP Vite login (CERT / mixed-content). cloud-start and
# `ring fe dev` under CURSOR_AGENT force it empty.
ENVIRONMENT=local
API_PORT=8001
SQLALCHEMY_DATABASE_URI=postgresql://ring-postgres:ring-postgres@db:5432/ring
COCKROACH_DATABASE_URI=cockroachdb://ringcockroach:ringcockroach@cockroach:26257/ring?sslmode=require
JWT_SIGNING_ALGORITHM=HS256
VITE_API_URL=
BACKEND_CORS_ORIGINS="https://localhost:5173 http://localhost:5173"
# Disable PWA service worker in cloud HTTP Vite (noise; unused in this path).
SW_DEV=false
VITE_MAINTENANCE_MODE=false
# Append secrets when bootstrapping (see README or cloud-start.sh):
# JWT_SIGNING_KEY=
# LLM_SERVICE_API_KEY=
# VAPID_PRIVATE_KEY=
# Blindfold push heartbeats. Leave unset to no-op. The API beat is the
# APScheduler job blindfold_heartbeat in this process (not a separate
# worker), every 5 minutes. An ok beat means that job's GET / on
# 127.0.0.1:$API_PORT returned 2xx. It does not prove the public
# hostname. intervalSeconds is 300 (stale after about 12.5 minutes).
# No stopping beat. HEARTBEAT_KEY_ID for this process is ring-api.
# Do not commit a secret.
# HEARTBEAT_URL=
# HEARTBEAT_KEY_ID=
# HEARTBEAT_SECRET=
# OpenTelemetry export for the API. Leave unset to skip the SDK.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Spotify account linking (authorization-code flow). All three must be set
# or the API reports linking as unavailable. Do not commit real secrets.
# Register SPOTIFY_REDIRECT_URI on the Spotify app (typically
# {public origin}/api/v1/spotify/callback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# Genesis IdP dual-sync (off by default). Prod: https://id.neilsriv.tech
# Local: http://127.0.0.1:4465 (uvicorn ring.vendor.genesis_idp.stub:app --port 4465)
# AUTH_DUAL_WRITE=false
# AUTH_DUAL_READ=false
# IDENTITY_SERVICE_BASE_URL=
# IDP_DIRECTORY_API_TOKEN=
# IDENTITY_SERVICE_IDENTITY_PATH=/api/v1/identities/{external_id}
# IDENTITY_SERVICE_COLLECTION_PATH=/api/v1/identities
# AUTH_DUAL_SYNC_TIMEOUT_SECONDS=2.0
